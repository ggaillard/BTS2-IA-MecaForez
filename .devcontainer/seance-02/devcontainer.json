{
  "name": "📏 Séance 2 — Mesurer un LLM (Python + Ollama)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "mechatroner.rainbow-csv",
        "yzhang.markdown-all-in-one",
        "GitHub.copilot-chat"
      ]
    }
  },
  "postCreateCommand": "bash .devcontainer/seance-02/installer-ollama.sh",
  "postStartCommand": "bash .devcontainer/seance-02/installer-ollama.sh --demarrer",
  "remoteEnv": { "MODELE": "qwen2.5:1.5b" }
}
